// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ===================== 枚举 =====================
/// 后台用户角色
enum adminRole {
  ADMIN // 超级管理员
  MANAGER // 店长
  STAFF // 客服
}

/// 用户角色
enum userRole {
  USER // 普通用户
  VIP // 会员
  MANAGER
  MANAGER_PRIMARY
  MANAGER_SENIOR
  PLATFORM // 平台
}

/// 代理人账号状态
enum AgentStatus {
  ACTIVE // 已启用
  DISABLED // 已停用
}

/// 邀请人免费次数使用状态
enum AgentInviteBenefitStatus {
  AVAILABLE // 可使用
  USED // 已核销
  EXPIRED // 已过期
}

/// 免费贴膜权益来源
enum FreeBenefitSource {
  VIP // VIP 免费次数
  AGENT_INVITE // 代理邀请赠送次数
}

// 通用激活/禁用状态
enum commonStatus {
  ACTIVE
  INACTIVE
}

/// 商品订单状态
enum OrderStatus {
  /// 待支付
  PENDING
  /// 已支付
  PAID
  /// 待发货
  SHIPPED
  /// 已完成
  COMPLETED
  /// 已取消
  CANCELLED
  /// 退款中
  PROCESSING
  /// 已退款
  REFUNDED
}

// 分类/商品目标枚举
enum Target {
  ALL
  TOC
  TOB
}

/// 会员订单状态
enum VipOrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDING
}

/// 订单支付方式
enum PaymentMethod {
  wechat
  alipay
  balance
}

/// 积分流水进出类型
enum PointsFlowType {
  INCOME
  EXPENSE
}

/// 线下服务订单状态
enum ServiceOrderStatus {
  PENDING // 待支付（扫码但未支付）
  PAID // 已支付（可开始服务）
  IN_SERVICE // 服务中（已开始）
  COMPLETED // 已完成
  CANCELLED // 已取消
  REFUNDED // 已退款
}

// =================================== 资金模块状态枚举 ===================================

/// 门店收入类型
enum StoreTransactionType {
  /// 收入（用户消费）
  INCOME
  /// 支出（进货）
  EXPENSE
}

/// 业务类型
enum StoreBizType {
  /// 商品销售
  PRODUCT
  /// 服务（如贴膜）
  SERVICE
  /// 进货
  PURCHASE
}

/// 结算状态 （结算表）
enum SettlementStatus {
  /// 待结算（订单已支付，但未完成）
  PENDING
  /// 已结算（已进入钱包）
  SETTLED
  /// 已取消（订单取消）
  CANCELLED
  /// 已退款（已结算后冲正）
  REFUNDED
}

/// 佣金到账状态 （佣金表）
enum CommissionStatus {
  /// 待结算
  PENDING
  /// 已到账
  SETTLED
  /// 已取消（订单未完成）
  CANCELLED
  /// 已撤回（退款后冲正）
  REVERSED
}

/// 佣金来源
enum CommissionSource {
  /// 平台承担
  PLATFORM
  /// 店长承担
  MANAGER
}

/// 钱包收支方向
enum WalletTransactionType {
  /// 收入
  IN
  /// 支出 
  OUT
}

/// 钱包业务类型
enum WalletBizType {
  /// 结算收入
  SETTLEMENT
  /// 佣金收入/支出 
  COMMISSION
  /// 提现
  WITHDRAW
  /// 退款
  REFUND
  /// 冲正（佣金回收）
  REVERSE
}

/// 提现状态
enum WithdrawStatus {
  /// 申请中
  APPLYING
  /// 已通过
  APPROVED
  /// 已拒绝
  REJECTED
  /// 已打款
  PAID
}

// =================================== 申请表 ===================================

// 招聘申请审核状态枚举
enum ReviewStatus {
  PENDING // 审核中
  APPROVED // 已通过
  REJECTED // 已拒绝
}

// 申请表类型
enum ApplyType {
  JOB
  BUSINESS
}

// =================================== 集合 ===================================

// 管理员表
model Admin {
  /// 管理员ID
  id        Int       @id @default(autoincrement())
  /// 登录用户名
  username  String    @unique
  /// 登录密码
  password  String
  /// 管理员角色
  role      adminRole @default(STAFF)
  /// 账号是否启用
  status    Boolean   @default(true)
  /// 创建时间
  createdAt DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("admin")
}

// banner
model Banner {
  /// Banner ID
  id        Int      @id @default(autoincrement())
  /// 图片或跳转地址
  url       String
  /// 排序值
  sort      Int      @default(0)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banner")
}

// 团队风采
model Team {
  /// 团队风采ID
  id     Int          @id @default(autoincrement())
  // 名称：如：孵化伙伴风采
  name   String
  // 图片地址
  image  String
  /// 启用状态
  status commonStatus @default(ACTIVE)

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 表名：team_show_case
  @@map("team_show_case")
}

// 商品分类
model Category {
  /// 分类ID
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  /// 分类名称
  name     String
  /// 父级ID（可选）
  parentId Int?   @map("parent_id") @db.UnsignedInt
  /// 分类层级
  level    Int?   @default(1)
  /// 排序值
  sort     Int?   @default(0)
  /// 分类适用对象
  target   Target @default(TOC)

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 关联
  products           Product[]
  /// 库存模板商品关联记录
  stockModelProducts StockModelProduct[]
  /// 门店库存记录
  storeInventories   StoreInventory[]

  @@index([target])
  @@index([level, target])
  @@map("category")
}

// 商品表
model Product {
  /// 商品ID
  id      Int     @id @default(autoincrement()) @db.UnsignedInt
  name    String  @db.Char(255) // 商品名称
  skuNo   String  @unique // 商品货号（唯一）
  dec     String? // 描述
  cover   String // 封面图
  lookNum Int     @default(0) // 浏览量
  status  String  @default("ACTIVE") // active/inactive
  hot     String  @default("DISABLE") // 热门 'ENABLE' | 'DISABLE'
  type    String  @default("BOTH") // user/manager/vip/both
  /// 商品适用对象
  target  Target  @default(TOC)

  /// 关联
  /// SKU 列表
  skus   ProductSku[]
  /// 商品图片
  images ProductImage[]
  /// 支持型号
  models ProductModel[]

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 挂叶子节点
  categoryId   Int     @db.UnsignedInt
  /// 分类名称快照
  categoryName String?

  /// 所属商品分类
  category        Category            @relation(fields: [categoryId], references: [id])
  /// 库存模板商品关联记录
  stockModelItems StockModelProduct[]

  @@index([target])
  @@index([target, categoryId])
  @@index([hot, target])
  @@map("product")
}

// SKU 表（核心！）
model ProductSku {
  /// SKUID
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  /// 商品ID
  productId Int      @db.UnsignedInt
  /// 成本价 
  costPrice Decimal? @map("cost_price") @db.Decimal(10, 2)
  /// 售价
  salePrice Decimal? @map("sale_price") @db.Decimal(10, 2)
  /// 库存
  stock     Int      @default(0)
  /// 最小库存
  minStock  Int?     @default(1)
  /// SKU封面图
  image     String?
  /// 属性：{颜色:"红色",尺寸:"M"}
  attrs     Json
  /// 单位
  unit      String   @default("片")
  /// 关联商品表
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 库存模板商品关联记录
  stockModelProducts StockModelProduct[]
  /// 门店库存
  inventory          StoreInventory[]

  @@map("product_sku")
}

// 商品图片表（proImages 拆表）
model ProductImage {
  /// 商品图片ID
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  /// 商品ID
  productId Int     @db.UnsignedInt
  url       String // 图片地址
  /// 所属商品
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

// 商品型号表（models 拆表）
model ProductModel {
  /// 商品型号ID
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  /// 商品ID
  productId Int     @db.UnsignedInt
  name      String // iPhone16Pro
  /// 所属商品
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_model")
}

// 通用型号主表
model PhoneModel {
  /// 手机型号ID
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  /// 手机型号名称
  name      String   @unique
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("phone_model")
}

// 全局配置表
model AppConfig {
  /// 配置键
  key       String   @id
  /// 配置值
  value     String   @db.Text
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

/// 用户表
model User {
  /// 唯一标识
  id                String       @id @default(cuid())
  /// 微信的用户标识id
  openid            String?      @unique
  /// 用户昵称
  nickname          String?
  /// 用户头像
  avatarUrl         String?      @map("avatar_url")
  /// 用户手机号码
  mobile            String       @unique
  /// 性别 0-未知 1-男 2-女
  gender            Int          @default(0)
  /// 用户角色 - user普通用户 vip会员 manager店长
  role              userRole     @default(USER)
  /// 用户归属--门店
  storeId           String?      @map("store_id")
  /// 注册时间
  createdAt         DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt         DateTime     @updatedAt @map("updated_at")
  /// 账号状态 - active激活 inactive未激活
  status            commonStatus @default(ACTIVE)
  /// 邀请码
  referralCode      String       @unique @map("referral_code")
  /// 上级的ID
  inviterId         String?      @map("inviter_id")
  /// vip可绑定的人数，默认为1
  vipMaxUsers       Int?         @map("vip_max_users")
  /// 会员等级： 1:基础会员, 2:高级会员, 3:至尊会员
  vipLevel          Int?         @map("vip_level")
  /// 会员注册时间
  vipStartTime      DateTime?    @map("vip_start_time")
  /// 会员到期时间
  vipEndTime        DateTime?    @map("vip_end_time")
  /// 会员权益：免费贴膜次数
  vipGift           Int?         @map("vip_gift")
  /// 最后一次免费贴膜的时间
  lastGiftTime      DateTime?    @map("last_gift_time")
  /// 会员折扣
  vipDiscount       Int?         @map("vip_discount")
  /// 邀请码图片链接
  myCodeUrl         String?      @map("my_code_url")
  /// 平台积分
  score             Int          @default(0)
  /// 用户更新头像的次数，超过1天后会重置
  avatarUpdateCount Int?         @default(3) @map("avatar_update_count")
  /// 更新头像的时间
  avatarUpdateAt    DateTime?    @updatedAt @map("avatar_update_at")

  /// ============= 关系 =============

  /// 邀请该用户的上级用户
  inviter  User?  @relation("UserInviter", fields: [inviterId], references: [id])
  /// 该用户邀请的下级用户
  invitees User[] @relation("UserInviter")

  /// 代理资格表
  agentProfile          AgentProfile?
  /// 邀请领取及代理权益
  agentInviteClaim      AgentInviteClaim?     @relation("AgentInvitee")
  /// 用户积分流水表
  pointsFlows           PointsFlow[]
  /// VIP订单表
  vipOrder              VipOrder[]
  /// 商品订单
  orders                Order[]
  /// 提现申请
  walletWithdrawApplies WalletWithdrawApply[]

  /// 门店归属--门店下有多少个会员/用户是否为店长 按身份区分
  store              Store?              @relation("StoreVip", fields: [storeId], references: [id])
  /// 店长--一个店长管理一个门店
  managedStore       Store?              @relation("StoreManager")
  /// 用户的线下贴膜订单
  storeServiceOrders StoreServiceOrder[]

  @@index([mobile])
  @@index([inviterId])
  @@index([referralCode])
  @@index([role, vipEndTime])
  @@index([role, storeId])
  @@map("user") // 数据库表名
}

/// ========================= 门店相关 =========================

/// 门店表
model Store {
  /// 主键ID（和User保持一致用cuid）
  id                  String       @id @default(cuid())
  /// 门店编码（用于二维码/对外展示）
  storeCode           String?      @unique @map("store_code")
  /// 门店名称
  name                String       @map("name")
  /// 门店Logo
  logo                String?      @map("logo")
  /// 门店地址
  address             String       @map("address")
  /// 联系电话
  phone               String       @map("phone")
  /// 收款二维码
  qrCodeUrl           String?      @map("qr_code_url")
  /// 店长ID（关联用户）
  managerId           String?      @unique @map("manager_id")
  /// 店长姓名
  managerName         String?      @map("manager_name")
  /// 店长等级
  managerLevel        userRole?    @map("manager_level")
  /// 上级门店ID（树结构）
  parentStoreId       String?      @map("parent_store_id")
  /// 门店状态
  status              commonStatus @default(ACTIVE)
  /// 是否选择了库存模板
  inventoryTemplateId Int?         @map("inventory_template_id") @db.UnsignedInt
  /// 创建时间
  createdAt           DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // ================= 关系 =================

  /// 门店下用户（会员）--- 门店推广了多少个会员
  users              User[]              @relation("StoreVip")
  /// 门店店长
  manager            User?               @relation("StoreManager", fields: [managerId], references: [id])
  /// 上级门店
  parent             Store?              @relation("StoreParent", fields: [parentStoreId], references: [id])
  /// 下级门店
  children           Store[]             @relation("StoreParent")
  // 初始化库存模版
  inventoryModel     StockModel?         @relation("StockModelToStore", fields: [inventoryTemplateId], references: [id])
  /// 门店库存
  inventory          StoreInventory[]
  /// 门店的线下贴膜订单
  storeServiceOrders StoreServiceOrder[]

  @@index([managerId])
  @@index([parentStoreId])
  @@map("store")
}

/// 门店库存表
model StoreInventory {
  /// 门店库存记录ID
  id          String       @id @default(cuid())
  /// 门店ID
  storeId     String       @map("store_id")
  /// 商品分类ID
  categoryId  Int          @map("category_id") @db.UnsignedInt
  /// 商品SKU ID
  skuId       Int          @map("sku_id") @db.UnsignedInt
  /// 库存数量
  stock       Int          @default(0)
  /// 锁定库存
  lockedStock Int          @default(0) @map("locked_stock")
  /// 销售数量
  soldCount   Int          @default(0) @map("sold_count")
  /// 成本价 
  costPrice   Decimal      @default(0) @map("cost_price") @db.Decimal(10, 2)
  /// 售价
  salePrice   Decimal      @default(0) @map("sale_price") @db.Decimal(10, 2)
  /// 库存记录状态
  status      commonStatus @default(ACTIVE)
  /// 创建时间
  createdAt   DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // ===================== 关系 =====================

  /// 所属门店
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// 对应商品SKU
  sku       ProductSku @relation(fields: [skuId], references: [id])
  /// 所属商品分类
  categorys Category   @relation(fields: [categoryId], references: [id])

  @@unique([storeId, skuId])
  @@index([storeId, categoryId])
  @@map("store_inventory")
}

// 库存模板表
model StockModel {
  /// 库存模板ID
  id        Int          @id @default(autoincrement()) @db.UnsignedInt
  /// 库存模板名称
  name      String       @unique
  /// 库存模板状态
  status    commonStatus @default(ACTIVE)
  /// 创建时间
  createdAt DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime     @updatedAt @map("updated_at")

  /// 库存模板与商品的关联（中间表）
  items  StockModelProduct[]
  /// 对应门店是否使用了库存模版
  stores Store[]             @relation("StockModelToStore")

  @@map("stock_model")
}

/// 库存模板与商品的关联（中间表）
model StockModelProduct {
  /// 库存模板商品记录ID
  id           Int @id @default(autoincrement())
  /// 库存模板ID
  stockModelId Int @db.UnsignedInt
  /// 商品分类ID
  categoryId   Int @db.UnsignedInt
  /// 商品ID
  productId    Int @db.UnsignedInt
  /// 商品SKU ID
  skuId        Int @db.UnsignedInt

  /// 初始配置数量
  initStock Int @default(0) @map("init_stock")

  /// 关联
  stockModel StockModel @relation(fields: [stockModelId], references: [id], onDelete: Cascade)
  /// 对应商品
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// 对应商品SKU
  skus       ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  /// 对应商品分类
  categorys  Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([skuId])
  @@map("stock_model_product")
}

/// ========================= 积分相关 =========================

/// 积分管理设置
model RateRule {
  /// 唯一标识
  id            String @id @default(cuid())
  /// 返积分比例：消费商品返回多少比例的积分，如10%，0.1等
  earnRate      Float? @default(0.1)
  ///  积分抵扣换算率：积分和人民币的换算比例，默认为 1：1
  useRate       Float? @default(1)
  /// 抵扣比例：当前订单里，订单总额，积分最大可抵扣的比例，如：10%，0.1等
  maxUsePercent Float? @default(0.1)

  @@map("rate_rule")
}

// 积分流水表
model PointsFlow {
  /// 积分流水ID
  id      Int            @id @default(autoincrement())
  /// 用户ID
  userId  String         @map("user_id")
  /// 所属用户
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  // 积分类型：收入/支出
  type    PointsFlowType
  // 积分变动数量（正数）
  amount  Int
  // 来源：分享好友/签到等
  source  String
  // 变动后余额
  balance Int

  /// 创建时间
  createdAt DateTime @default(now()) @map("create_at") @db.DateTime(3)

  // 索引：查用户流水必加
  @@index([userId])
  @@map("points_flow")
}

/// ========================= 订单相关 =========================
/// 用户订单主表
model Order {
  /// 商品订单ID
  id            String  @id @default(cuid())
  /// 商户订单号
  outTradeNo    String  @unique @map("out_trade_no")
  /// 第三方支付交易号
  transactionId String? @map("transaction_id")

  /// 订单状态
  status OrderStatus
  /// 订单适用对象
  target Target      @default(TOC)

  /// 用户微信OPENID
  openid    String
  /// 用户ID
  userId    String  @map("user_id")
  /// 用户昵称快照
  nickname  String
  /// 用户手机号快照
  mobile    String
  /// 用户头像快照
  avatarUrl String? @map("avatar_url")

  /// 订单总件数
  totalCount    Int     @map("total_count")
  /// 原价总金额（没打折前）
  totalPrice    Decimal @map("total_price") @db.Decimal(10, 2)
  /// 优惠/抵扣的钱（少收的钱）
  deductAmount  Decimal @map("deduct_amount") @db.Decimal(10, 2)
  /// 用户实际掏的钱
  actualPayment Decimal @map("actual_payment") @db.Decimal(10, 2)
  /// 抵扣的积分
  usedScore     Int?    @map("used_score")

  /// 支付方式
  paymentMethod PaymentMethod? @map("payment_method")
  /// 支付流水号
  paymentNo     String?        @map("payment_no")

  /// 订单备注
  remark String?

  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 支付时间
  paidAt       DateTime? @map("paid_at")
  /// 发货时间
  shippedAt    DateTime? @map("shipped_at")
  /// 完成时间
  completedAt  DateTime? @map("completed_at")
  /// 取消时间
  cancelledAt  DateTime? @map("cancelled_at")
  /// 取消原因
  cancelReason String?   @map("cancel_reason")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("update_at")

  // 关联
  user     User           @relation(fields: [userId], references: [id])
  /// 订单商品明细
  products OrderProduct[]
  /// 订单收货地址
  address  OrderAddress?

  @@index([userId, status])
  @@index([outTradeNo])
  @@map("order")
}

/// 订单商品表中间表
model OrderProduct {
  /// 订单商品记录ID
  id      String @id @default(cuid())
  /// 商品订单ID
  orderId String @map("order_id")

  /// 商品ID
  productId Int     @map("product_id")
  /// 商品型号
  model     String?
  /// 商品货号
  skuNo     String  @map("sku_no")
  /// 商品名称快照
  name      String
  /// 商品单价
  price     Decimal @db.Decimal(10, 2)
  /// 购买数量
  quantity  Int
  /// 商品图片快照
  image     String?

  /// 商品SKU ID
  skuId   Int?    @map("sku_id")
  /// SKU名称快照
  skuName String? @map("sku_name")

  /// 所属商品订单
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_product")
}

/// 订单地址表
model OrderAddress {
  /// 订单地址记录ID
  id      String @id @default(cuid())
  /// 商品订单ID
  orderId String @unique @map("order_id")

  /// 收货人姓名
  name         String
  /// 收货人手机号
  mobile       String
  /// 省份
  province     String
  /// 城市
  city         String
  /// 区县
  county       String
  /// 邮政编码
  postalCode   String? @map("postal_code")
  /// 国家或地区编码
  nationalCode String? @map("national_code")
  /// 详细地址
  detail       String

  /// 所属商品订单
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_address")
}

// 会员订单表（用户购买VIP的订单记录）
model VipOrder {
  /// VIP订单ID
  id            Int     @id @default(autoincrement())
  /// 商户订单号
  outTradeNo    String  @unique
  /// 第三方支付交易号
  transactionId String?

  /// 用户微信OPENID
  openid     String
  /// 用户ID
  userId     String
  /// 用户手机号快照
  userMobile String
  /// VIP套餐ID
  vipProId   Int

  /// 会员等级
  vipLevel     Int
  // 会员名称
  vipLevelText String         @db.VarChar(50)
  // 支付金额（元）
  amount       Decimal        @db.Decimal(10, 2)
  // 折扣金额
  discount     Decimal        @db.Decimal(10, 2)
  // 限制次数
  limit        Int
  // 最大用户数
  maxUsers     Int
  // 有效期天数
  term         String         @db.VarChar(10)
  /// 订单备注
  remark       String?
  // 订单状态 PAID 等
  status       VipOrderStatus
  // 创建时间
  createdAt    DateTime       @default(now())
  // 支付时间
  paidAt       DateTime?      @map("paid_at")
  // 更新时间
  updatedAt    DateTime       @updatedAt

  /// 关联
  vipPlan VipPlan @relation(fields: [vipProId], references: [id], onDelete: Cascade)
  /// 下单用户
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId]) // 用户ID索引
  @@index([outTradeNo]) // 订单号索引
  @@index([status]) // 状态索引
  @@map("vip_order") // 数据库表名
}

/// 线下贴膜订单表
model StoreServiceOrder {
  /// 线下贴膜订单ID
  id                 String             @id @default(cuid())
  /// 门店ID
  storeId            String             @map("store_id")
  /// 用户ID
  userId             String?            @map("user_id")
  /// 会员手机号
  memberPhone        String?            @map("member_phone")
  /// 微信OPENID
  openid             String?
  /// 订单编号
  outTradeNo         String             @unique @map("out_trade_no")
  /// 商品ID
  productId          Int                @map("product_id")
  /// 商品名称快照
  productName        String?            @map("product_name") @db.VarChar(255)
  /// 商品封面快照
  productCover       String?
  /// SKUID
  skuId              Int                @map("sku_id")
  /// 货号
  skuNo              String             @map("sku_no")
  /// 原价
  originalPrice      Decimal            @map("original_price") @db.Decimal(10, 2)
  /// 实付金额
  actualPayment      Decimal            @map("actual_payment") @db.Decimal(10, 2)
  /// 支付方式
  paymentMethod      PaymentMethod      @default(wechat)
  /// 状态（核心）
  status             ServiceOrderStatus @default(PENDING)
  /// 完成时间
  completedAt        DateTime?          @map("completed_at")
  /// 取消时间
  cancelledAt        DateTime?          @map("cancelled_at")
  /// 支付时间
  paidAt             DateTime?          @map("paid_at")
  /// 备注
  remark             String?            @default("线下贴膜")
  /// 免费贴膜权益来源
  freeBenefitSource  FreeBenefitSource? @map("free_benefit_source")
  /// 代理邀请领取记录ID
  agentInviteClaimId String?            @map("agent_invite_claim_id")
  /// 创建时间
  createdAt          DateTime           @default(now()) @map("created_at")

  /// 下单用户
  user             User?             @relation(fields: [userId], references: [id])
  /// 服务门店
  store            Store             @relation(fields: [storeId], references: [id])
  /// 使用的代理邀请权益记录
  agentInviteClaim AgentInviteClaim? @relation(fields: [agentInviteClaimId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@index([storeId, userId])
  @@index([outTradeNo])
  @@index([storeId, status, createdAt])
  @@index([agentInviteClaimId])
  @@map("store_service_order")
}

/// ========================= 资金模块 =========================

/// 门店流水/业务记录
model StoreTransaction {
  /// 门店流水ID
  id             Int                  @id @default(autoincrement())
  /// 门店ID（平台消费可用 cmnyglwkl0001wkj0p7os6u8c = 平台虚拟门店）
  storeId        String               @map("store_id")
  /// 操作人（用户 / 店长 / 员工）      
  operatorId     String?              @map("operator_id")
  /// 消费者 ID 
  consumerId     String?              @map("consumer_id") // 谁消费（核心字段）注册了就是userId,没注册就是openid
  /// 类型：INCOME（收入） / EXPENSE（支出）
  type           StoreTransactionType
  /// 业务类型：PRODUCT（商品）/ SERVICE（服务）/ PURCHASE（进货）  
  bizType        StoreBizType         @map("bize_type")
  /// 金额（只记录业务金额）
  amount         Decimal              @db.Decimal(10, 2)
  /// 关联订单ID（消费）
  relatedOrderId String?              @map("related_order_id")
  /// 关联业务ID（如进货单）    
  relatedBizId   String?              @map("related_biz_id")
  /// 备注（如：平台商品消费）
  remark         String?

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  @@map("store_transaction")
}

/// 结算表 
model SettlementRecord {
  /// 结算记录ID
  id        Int    @id @default(autoincrement())
  /// 门店ID（平台=cmnyglwkl0001wkj0p7os6u8c）
  storeId   String @map("store_id")
  /// 店长ID（平台=cmnyglwkl0001wkj0p7os6u8c）       
  managerId String @map("manager_id")

  /// 订单ID（唯一，防重复结算）
  orderId         String           @unique @map("order_id")
  /// 订单金额
  orderAmount     Decimal          @map("order_amount") @db.Decimal(10, 2)
  /// 平台抽成比例（%）
  platformRate    Decimal          @map("platform_rate") @db.Decimal(5, 2)
  /// 平台抽成金额
  platformFee     Decimal          @map("platform_fee") @db.Decimal(10, 2)
  /// 店长应得（平台消费为0）
  managerIncome   Decimal          @default(0.00) @map("manager_income") @db.Decimal(10, 2)
  /// 上级佣金
  totalCommission Decimal          @default(0.00) @map("total_commission") @db.Decimal(10, 2)
  /// 状态：PENDING / SETTLED / CANCELLED / REFUNDED
  status          SettlementStatus
  /// 结算时间
  settledAt       DateTime?        @map("settle_at")

  /// 创建时间
  createdAt DateTime @default(now()) @map("create_at")

  @@map("settlement_record")
}

/// 佣金表
model CommissionRecord {
  /// 佣金记录ID
  id               Int              @id @default(autoincrement())
  /// 收佣人（上级）
  userId           String           @map("user_id")
  /// 贡献人（消费用户）      
  fromUserId       String           @map("from_user_id")
  /// 类型：ORDER（消费） / PURCHASE（进货） / SERVICE (服务/线下贴膜)
  type             StoreBizType
  /// 关联ID（订单ID或业务ID）
  relatedId        String           @map("related_id")
  /// 佣金金额
  amount           Decimal          @db.Decimal(10, 2)
  /// 佣金比例
  rate             Decimal          @db.Decimal(5, 2)
  /// 来源：PLATFORM（平台出）/ MANAGER（店长出）
  commissionSource CommissionSource @map("commission_source")
  /// 状态：PENDING / SETTLED
  status           CommissionStatus @default(PENDING)
  /// 结算时间 
  settledAt        DateTime?        @map("settled_at")

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  @@map("commission_record")
}

/// 钱包
model Wallet {
  /// 钱包所属用户ID
  userId           String  @id @map("user_id")
  /// 总余额
  balance          Decimal @default(0) @db.Decimal(10, 2)
  /// 可用余额
  availableBalance Decimal @default(0) @map("available_balance") @db.Decimal(10, 2)
  /// 冻结金额
  frozenBalance    Decimal @default(0) @map("frozen_balance") @db.Decimal(10, 2)

  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallet")
}

/// 提现申请表
model WalletWithdrawApply {
  /// 提现申请ID
  id Int @id @default(autoincrement())

  /// 提现单号
  withdrawNo String @unique @default(cuid()) @map("withdraw_no")

  /// 申请用户ID
  userId String @map("user_id")

  /// 提现金额
  amount Decimal @db.Decimal(10, 2)

  /// 状态：APPLYING / APPROVED / REJECTED / PAID
  status WithdrawStatus @default(APPLYING)

  /// 收款人姓名
  payeeName String? @map("payee_name")

  /// 收款账号 / openid / 支付宝账号等
  payeeAccount String? @map("payee_account")

  /// 开户银行名称
  bankName String? @map("bank_name")

  /// 审核人ID，对应 Admin.id
  reviewerId Int? @map("reviewer_id")

  /// 拒绝原因
  rejectReason String? @map("reject_reason")

  /// 申请时间
  createdAt DateTime @default(now()) @map("created_at")

  /// 审核时间
  reviewedAt DateTime? @map("reviewed_at")

  /// 打款时间
  paidAt DateTime? @map("paid_at")

  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 申请提现的用户
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_withdraw_apply")
}

/// 资金流水(钱包)
model WalletTransaction {
  /// 钱包流水ID
  id           Int                   @id @default(autoincrement())
  /// 账户ID（用户 / 店长 / 平台）
  userId       String                @map("user_id")
  /// IN（收入）/ OUT（支出）
  type         WalletTransactionType
  /// SETTLEMENT / COMMISSION / WITHDRAW
  bizType      WalletBizType         @map("biz_type")
  /// 变动金额
  amount       Decimal               @db.Decimal(10, 2)
  /// 变动后余额（用于审计）
  balanceAfter Decimal               @map("balance_after") @db.Decimal(10, 2)
  /// 关联ID（结算ID / 佣金ID）
  relatedId    Int?                  @map("related_id")
  /// 备注（如：订单佣金）
  remark       String?

  /// 创建时间
  createdAt DateTime @default(now()) @map("create_at")

  @@map("wallet_transaction")
}

/// 佣金规则
model CommissionRule {
  /// 佣金规则ID
  id           Int     @id @default(autoincrement())
  /// 一级佣金比例
  level1Rate   Decimal @map("level1_rate") @db.Decimal(10, 2)
  /// 二级佣金比例
  level2Rate   Decimal @map("level2_rate") @db.Decimal(10, 2)
  /// 平台抽成比例
  platformRate Decimal @map("platform_rate") @db.Decimal(10, 2)
  /// 总比例
  totalRate    Decimal @map("total_rate") @db.Decimal(10, 2)

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("commission_rule")
}

/// ========================= 会员相关 =========================
// 会员套餐表
model VipPlan {
  /// VIP套餐ID
  id           Int          @id @default(autoincrement())
  /// 会员等级
  level        Int
  /// 会员等级名称
  levelText    String       @map("level_text")
  /// 套餐价格
  price        Decimal      @db.Decimal(10, 2)
  /// 会员折扣
  discount     Float
  /// 套餐有效期
  term         String
  /// 套餐权益说明
  rights       String
  /// 套餐状态
  status       commonStatus
  /// 创建时间
  createdAt    DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime     @updatedAt @map("updated_at")
  /// 返现比例
  cashbackRate Float        @map("cashback_rate")
  /// 最大可绑定用户数
  maxUsers     Int          @map("max_users")
  /// 免费贴膜次数
  limit        Int
  /// 使用该套餐创建的VIP订单
  vipOrder     VipOrder[]

  @@map("vip_plan")
}

/// 申请表
model JobApply {
  /// 申请记录ID
  id         Int          @id @default(autoincrement())
  /// 申请用户ID
  userId     String       @map("user_id")
  /// 申请人姓名
  name       String
  /// 申请人手机号
  mobile     String
  /// 身份证正面图片
  icCardFont String       @map("ic_card_font")
  /// 身份证反面图片
  icCardBack String       @map("ic_card_back")
  /// 业务或申请说明
  business   String?
  /// 申请类型
  type       ApplyType
  /// 审核状态
  status     ReviewStatus
  /// 创建时间
  createdAt  DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt  DateTime     @updatedAt

  @@index([userId, type])
  @@map("job_apply")
}

/// ========================= 代理相关 =========================

/// 代理资格表
model AgentProfile {
  /// 代理资格记录ID
  id        String      @id @default(cuid())
  /// 代理用户ID，同一用户只能拥有一个代理身份
  userId    String      @unique @map("user_id")
  /// 代理邀请码，停用后恢复时继续使用原邀请码
  agentCode String      @unique @map("agent_code") @db.VarChar(16)
  /// 代理邀请码二维码图片链接
  agentCodeUrl String?  @map("agent_code_url") @db.VarChar(500)
  /// 代理账号状态
  status    AgentStatus @default(ACTIVE)

  /// 开通代理资格的管理员ID
  openedBy Int?     @map("opened_by")
  /// 代理资格开通时间
  openedAt DateTime @default(now()) @map("opened_at")

  /// 停用代理资格的管理员ID
  disabledBy     Int?      @map("disabled_by")
  /// 代理资格停用时间
  disabledAt     DateTime? @map("disabled_at")
  /// 代理资格停用原因
  disabledReason String?   @map("disabled_reason") @db.VarChar(200)

  /// 后台备注
  remark    String?  @db.VarChar(200)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 代理对应的用户
  user   User               @relation(fields: [userId], references: [id])
  /// 该代理产生的邀请领取记录
  claims AgentInviteClaim[]

  @@index([status, createdAt])
  @@map("agent_profile")
}

/// 邀请领取及代理权益表
model AgentInviteClaim {
  /// 邀请领取记录ID
  id            String  @id @default(cuid())
  /// 邀请人的代理资格记录ID
  agentId       String  @map("agent_id")
  /// 被邀请用户ID，每个用户全平台最多领取一次
  inviteeUserId String  @unique @map("invitee_user_id")
  /// 邀请链路追踪ID
  traceId       String? @map("trace_id") @db.VarChar(64)

  /// 权益领取时间
  claimedAt     DateTime                 @default(now()) @map("claimed_at")
  /// 权益到期时间
  expiresAt     DateTime                 @map("expires_at")
  /// 代理邀请赠送权益状态
  benefitStatus AgentInviteBenefitStatus @default(AVAILABLE) @map("benefit_status")

  /// 最近一次核销时间
  usedAt    DateTime? @map("used_at")
  /// 创建时间
  createdAt DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime  @updatedAt @map("updated_at")

  /// 发起邀请的代理
  agent         AgentProfile        @relation(fields: [agentId], references: [id])
  /// 领取权益的用户
  invitee       User                @relation("AgentInvitee", fields: [inviteeUserId], references: [id])
  /// 使用过该权益的线下贴膜订单
  serviceOrders StoreServiceOrder[]

  @@index([agentId, claimedAt])
  @@index([inviteeUserId, benefitStatus, expiresAt])
  @@index([traceId])
  @@map("agent_invite_claim")
}
